# pixi environments
.pixi/*
!.pixi/config.toml

# Build output
build/
static/
web/node_modules/
web/bun.lockb

# Benchmark output - regenerated every run, never reviewed in a diff
visualbench/
chartbench/

# Scratch
probe/
*.mojopkg

# Runtime state
var/
*.db
*.db-wal
*.db-shm
*.log

# Secrets
.env
.env.*
!.env.example
secrets/

# Python environments - this repo's own, built by scripts/setup-venvs.sh
.venv/
.venv-*/
*.egg-info/

# Embedding weights: 16 MB of int8 model copied out of ../gobed by
# scripts/setup-venvs.sh. Fetched, never committed.
models/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
