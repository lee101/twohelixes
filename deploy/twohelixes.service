[Unit]
Description=twoHelixes analytics agent (Mojo server)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/nvme0n1-disk/code/twohelixes

Environment=TWOHELIXES_PORT=7474
Environment=TWOHELIXES_WORKERS=4
Environment=TWOHELIXES_PROD=1
Environment=TWOHELIXES_SITE_URL=https://twohelixes.com
Environment=TWOHELIXES_STATIC_URL=https://twohelixesstatic.twohelixes.com
Environment=R2_PUBLIC_HOST=twohelixesstatic.twohelixes.com
Environment=R2_BUCKET=twohelixesstatic
Environment=TWOHELIXES_INTERP=/nvme0n1-disk/code/twohelixes/interp
# The AOT Mojo binary uses CPython's C API but does not link libpython itself.
# setup-venvs.sh copies the exact runtime library into the venv so systemd can
# make its symbols global before std.python boots the interpreter.
Environment=LD_PRELOAD=/nvme0n1-disk/code/twohelixes/.venv/lib/libpython3.12.so.1.0
Environment=TWOHELIXES_SITE_PACKAGES=/nvme0n1-disk/code/twohelixes/.venv/lib/python3.12/site-packages

# Secrets and per-host settings, root-owned and 0600. This file is in git, so
# the Postgres DSN - which carries a password - lives there instead.
#
# `TWOHELIXES_PG_DSN` in that file is what selects Postgres. Remove it and the
# server falls back to SQLite at var/twohelixes.db, which is the rollback: the
# file is still there and still current as of the migration.
EnvironmentFile=-/etc/twohelixes.env

ExecStart=/nvme0n1-disk/code/twohelixes/build/twohelixes-server

Restart=always
RestartSec=3
# The worker processes are forked children; kill the whole group on stop.
KillMode=control-group
TimeoutStopSec=20

StandardOutput=append:/nvme0n1-disk/code/twohelixes/var/server.log
StandardError=append:/nvme0n1-disk/code/twohelixes/var/server.log

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
